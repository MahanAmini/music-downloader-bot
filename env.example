# Telegram Bot Token — get it from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Genius API Token — get it from https://genius.com/api-clients
GENIUS_API_TOKEN=your_genius_api_key_here

# NOTE:
# iTunes Search API, lrclib, and lyrics.ovh do NOT require API keys,
# so no additional variables are needed for them.
