# =========================================
# Telegram Bot
# =========================================
# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =========================================
# Spotify API Credentials
# =========================================
# Create an app at https://developer.spotify.com/dashboard
# to get your Client ID and Client Secret
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# =========================================
# Proxy Settings (optional)
# =========================================
# Used to route yt-dlp/spotdl requests through a proxy —
# helpful if YouTube/SoundCloud rate-limit or block your server's IP.
# Leave these empty if you don't need a proxy.
PROXY_USERNAME=your_proxy_username_here
PROXY_PASSWORD=your_proxy_password_here
PROXY_HOST=your_proxy_host_here
PROXY_PORT=your_proxy_port_here

# =========================================
# Cookies File (optional)
# =========================================
# Filename of the cookies file (Netscape format) placed in the project root.
# Used by yt-dlp/spotdl to bypass age/region restrictions or bot checks
# on YouTube. Leave as-is if you keep the default filename.
COOKIE_FILENAME=cookies.txt
